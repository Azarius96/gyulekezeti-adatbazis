DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Generáld: openssl rand -hex 32 — production módban kötelező, min. 32 karakter, ne legyen az alapértelmezett.
JWT_SECRET="CHANGE_ME"
PORT=4000
NODE_ENV=production
# Éles, konténerizált telepítésnél (pl. Coolify) "direct" - a pg_dump/pg_restore közvetlenül,
# hálózaton keresztül éri el a Postgres-t (nincs szükség Docker socket hozzáférésre). Helyi
# fejlesztésnél maradjon "docker" (alapértelmezett) - ott a Node a hoszton fut, a Postgres
# viszont Docker-konténerben, ezért `docker exec`-en keresztül hívjuk a binárisokat.
BACKUP_STRATEGY=docker
# Csak "docker" módban használt: a Postgres Docker-konténer neve, amin a heti automatikus
# mentés a pg_dump/pg_restore-t futtatja.
DB_DOCKER_CONTAINER=gyulekezetiadatbazis-db-1
# Csak éles, egybe-buildelt telepítésnél: a lebuildelt frontend (web/dist) elérési útja - ha be
# van állítva és létezik, a szerver saját maga szolgálja ki ugyanarról az originről.
WEB_DIST_PATH=
